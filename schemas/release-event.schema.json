{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Run release observer terminal event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event",
    "status",
    "reason",
    "repository",
    "repository_id",
    "tag",
    "commit",
    "run_id",
    "run_attempt",
    "release_url",
    "manifest_sha256",
    "artifact_integrity",
    "provenance_verification",
    "installed",
    "agent_awakened",
    "notification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event": {
      "enum": [
        "release.ready",
        "release.finished"
      ]
    },
    "status": {
      "enum": [
        "released",
        "failed",
        "timeout",
        "cancelled"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 256
    },
    "repository": {
      "const": "DKotsyuba/agent-run"
    },
    "repository_id": {
      "const": 1348534205
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "run_id": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "run_attempt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "release_url": {
      "type": "string",
      "pattern": "^https://github.com/DKotsyuba/agent-run/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_integrity": {
      "enum": [
        "verified",
        "not_verified"
      ]
    },
    "provenance_verification": {
      "const": "not_performed"
    },
    "installed": {
      "const": false
    },
    "agent_awakened": {
      "const": false
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "pending",
            "acknowledged",
            "failed"
          ]
        }
      }
    }
  }
}
