{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "version",
    "tag",
    "repository",
    "repository_id",
    "commit",
    "workflow",
    "standard_version",
    "devkit_version",
    "baseline",
    "schema_version",
    "trust_profile",
    "artifacts"
  ],
  "properties": {
    "product": {
      "const": "agent-run"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "repository": {
      "const": "DKotsyuba/agent-run"
    },
    "repository_id": {
      "const": 1348534205
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "run_id",
        "run_attempt"
      ],
      "properties": {
        "id": {
          "const": 346709607
        },
        "path": {
          "const": ".github/workflows/release.yml"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "standard_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "devkit_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "baseline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schema_version": {
      "const": 1
    },
    "trust_profile": {
      "const": "github-attestation"
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "size",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$",
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "bundle",
              "source",
              "installer",
              "evidence"
            ]
          },
          "target": {
            "const": "aarch64-apple-darwin"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "bundle"
                }
              }
            },
            "then": {
              "required": [
                "target"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "target"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Run published release manifest v1"
}
