    "pool_get": {
     "name": "pool_get",
     "description": "Read one bounded authenticated section. Forward history may wait up to 25 seconds; reverse history uses next_before. Content pages require field=purpose|snapshot and the prior expected_revision on continuation. Structured ballot checks follow vote_event_id in history. proposal_id selects a retained decision; owner-only binding requires member_id.",
     "inputSchema": {
      "additionalProperties": false,
      "properties": {
       "after": {
        "minimum": 0,
        "type": "integer"
       },
       "before": {
        "maxLength": 19,
        "pattern": "^[1-9][0-9]*$",
        "type": "string"
       },
       "expected_revision": {
        "minimum": 1,
        "type": "integer"
       },
       "field": {
        "enum": [
         "purpose",
         "snapshot"
        ],
        "type": "string"
       },
       "member_id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       },
       "pool_id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       },
       "proposal_id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       },
       "reverse": {
        "type": "boolean"
       },
       "section": {
        "enum": [
         "overview",
         "members",
         "history",
         "proposal",
         "votes",
         "criteria",
         "content",
         "deliveries",
         "binding"
        ],
        "type": "string"
       },
       "wait_seconds": {
        "maximum": 25,
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "pool_id"
