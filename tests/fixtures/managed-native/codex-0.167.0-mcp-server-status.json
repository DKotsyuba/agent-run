    "pool_vote": {
     "name": "pool_vote",
     "description": "Confirmed members vote against exact proposal_id and roster_key. Structured ready requires a check for every acceptance criterion; an unmet check is recorded but prevents agreement. Other pools require ready/block evidence. Acceptance never closes the pool or stops agents.",
     "inputSchema": {
      "additionalProperties": false,
      "properties": {
       "checks": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "criterion_id": {
           "maxLength": 32,
           "minLength": 1,
           "type": "string"
          },
          "evidence": {
           "maxLength": 1024,
           "minLength": 1,
           "type": "string"
          },
          "status": {
           "enum": [
            "met",
            "unmet"
           ],
           "type": "string"
          }
         },
         "required": [
          "criterion_id",
          "status",
          "evidence"
         ],
         "type": "object"
        },
        "maxItems": 10,
        "type": "array"
       },
       "choice": {
        "enum": [
         "ready",
         "block",
         "revoke"
        ],
        "type": "string"
       },
       "evidence": {
        "maxLength": 2048,
        "type": "string"
       },
       "expected_revision": {
        "minimum": 1,
