# Paths and accounts are controlled by the host administrator.
AR_BINARY=/usr/local/bin/agent-run
AR_STATE=/var/lib/agent-run
AR_ROUTES=/etc/agent-run/routes.toml
AR_GROUP=agent-run
AR_BROKER_USER=operator
AR_BROKER_HOME=/home/operator
AR_BROKER_TMP=/var/lib/agent-run/tmp
AR_BROKER_PATH=/usr/local/bin:/usr/bin:/bin
AR_CODEX_USER=codex-agent
AR_CODEX_GROUP=codex-agent
AR_CODEX_HOME=/home/codex-agent
AR_CODEX_TMP=/home/codex-agent/.agent-run/tmp
AR_CODEX_PATH=/home/codex-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
AR_CLAUDE_USER=claude-agent
AR_CLAUDE_GROUP=claude-agent
AR_CLAUDE_HOME=/home/claude-agent
AR_CLAUDE_TMP=/home/claude-agent/.agent-run/tmp
AR_CLAUDE_PATH=/home/claude-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
AR_OPERATOR=/run/agent-run/broker/api.sock
AR_WRITER=/run/agent-run/broker/writer.sock
AR_CODEX_WORKER=/run/agent-run/codex/worker.sock
AR_CLAUDE_WORKER=/run/agent-run/claude/worker.sock
AR_CODEX_CLIENT=/run/agent-run/codex-client/api.sock
AR_CLAUDE_CLIENT=/run/agent-run/claude-client/api.sock
