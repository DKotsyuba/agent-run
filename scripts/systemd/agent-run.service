[Unit]
Description=Shared Agent Run service
After=network-online.target

[Service]
Type=notify
NotifyAccess=all
EnvironmentFile=/etc/agent-run/service.env
ExecStart=/usr/local/libexec/agent-run-service
RuntimeDirectory=agent-run
RuntimeDirectoryMode=0755
UMask=0007
KillMode=mixed
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
